NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://nulll.club
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
NULLL_ADMIN_CODE=
# Identifiants de compte (UUID, séparés par des virgules) exclus du compteur de visites, en plus des admins.
VISITES_EQUIPE=

# Services de la page Sécurité (tous facultatifs : sans eux, la carte dit « à configurer »).
# Sentry : erreurs serveur et navigateur. DSN public du projet, puis org, slug du projet et jeton (scopes project:read, event:read, org:read).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# SonarCloud : clé du projet (sonar-project.properties). Jeton seulement si le projet devient privé.
SONAR_PROJECT_KEY=nulllclubcontact-fr_NULLL
SONAR_TOKEN=
# GitHub : jeton facultatif (lecture des actions) pour ne pas subir la limite anonyme de 60 appels par heure.
GITHUB_TOKEN=
# UptimeRobot : clé API en lecture seule, moniteur HTTP sur https://nulll.club/api/sante toutes les 5 minutes.
UPTIMEROBOT_API_KEY=
